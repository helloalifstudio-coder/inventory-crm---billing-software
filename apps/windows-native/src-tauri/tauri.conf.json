{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGM Showroom Suite",
  "version": "2.0.0",
  "identifier": "com.alifgrowthmedia.agmshowroom",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AGM Showroom Suite — Inventory CRM & Billing Counter",
        "url": "index.html",
        "width": 1380,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Alif Growth Media",
    "copyright": "Copyright (c) 2026 Alif Growth Media",
    "shortDescription": "Apparel Showroom Inventory CRM & GST Billing Counter",
    "category": "Business",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
